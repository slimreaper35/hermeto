ARG HERMETO_BASE_IMAGE
FROM $HERMETO_BASE_IMAGE

# Run explicitly as root. The production image runs as user 1001,
# but rootless podman cannot cleanly combine that with host bind mounts.
USER 0

COPY CA.crt /etc/pki/ca-trust/source/anchors/test-ca.crt
ENV REQUESTS_CA_BUNDLE=/etc/pki/tls/certs/ca-bundle.crt
RUN update-ca-trust
